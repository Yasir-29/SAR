# Copernicus Data Space Ecosystem (CDSE) API Credentials
# Register for free credentials at https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Google Maps / Street View Static API Key
GOOGLE_MAPS_API_KEY=

# Certified PyTorch Model Checkpoint
MODEL_PATH=data/tamil_nadu/final/checkpoints/tamil_nadu_phase9_best.pt

# Imagery & Analysis Defaults
CLOUD_COVER_MAX=30
AOI_SIZE_METERS=500

# Set to false when live CDSE credentials are provided
MOCK_SATELLITE_API=true
